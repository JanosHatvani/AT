<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>AT.Automation.Mobile</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\AT.Core\AT.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Appium.WebDriver" Version="8.0.0" />
		<PackageReference Include="Selenium.Support" Version="4.29.0" />
	</ItemGroup>

	<!--
		Az AndroidSdkLocator osztály szándékosan "internal" marad (nem publikus API),
		de az AT.App projektnek (a MobileTestViewModel-en keresztül) hozzáférésre van
		szüksége hozzá, hogy futtatás előtt PROAKTÍVAN tudjon figyelmeztetni a hiányzó
		Android SDK-ra (TryDescribeMissingSdk), ahelyett hogy csak egy lépés menet
		közbeni sikertelenségekor derülne ki. Az InternalsVisibleTo pontosan egy
		nevesített assembly-nek (AT.App) ad hozzáférést, semmi másnak — ez tisztább,
		mint az AndroidSdkLocator-t teljesen publikussá tenni.
	-->
	<ItemGroup>
		<InternalsVisibleTo Include="AT.App" />
	</ItemGroup>
</Project>
