<Project>
  <!--
    Self-contained, single-file publish profil az AT.App (WPF, .NET 9.0) projekthez.

    HASZNÁLAT (a solution gyökeréből, PowerShell/cmd-ből):
      dotnet publish AT.App\AT.App.csproj -c Release -p:PublishProfile=AT.App\Properties\PublishProfiles\SelfContainedWinX64.pubxml

    Ez létrehoz egy önálló, függőségmentes .exe-t (nincs szükség előzetesen telepített
    .NET runtime-ra a célgépen), a kimenet itt lesz:
      AT.App\bin\Release\net9.0-windows\win-x64\publish\AT.App.exe

    Ezt a mappát fogja becsomagolni az Inno Setup szkript (lásd ATStudioSetup.iss).
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net9.0-windows\win-x64\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net9.0-windows</TargetFramework>

    <!-- Self-contained: a .NET runtime bekerül a kimenetbe, nem kell előre telepíteni. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Egyetlen .exe fájlba csomagolja az összes DLL-t (a natív .dll-eken kívül,
         amiket a WPF/WebView2 vagy más natív függőségek igényelhetnek — ezek külön
         fájlként maradnak a publish mappában, ez normális). -->
    <PublishSingleFile>true</PublishSingleFile>

    <!-- Kikapcsolja a "ReadyToRun" képek trimmelését — WPF-appoknál a Trimming
         (PublishTrimmed) gyakran problémás (reflection-alapú kötések eltűnhetnek),
         ezért ezt szándékosan NEM kapcsoljuk be. -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Az .exe induláskor kicsomagolja magát egy ideiglenes mappába — ez normális,
         self-contained single-file appoknál elvárt működés, nem hiba. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Windows GUI app (nem konzol) — nem nyit parancssori ablakot induláskor. -->
    <SelfContainedWindows>true</SelfContainedWindows>
  </PropertyGroup>
</Project>
