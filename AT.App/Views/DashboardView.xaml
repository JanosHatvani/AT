<UserControl x:Class="AT.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="900" d:DesignHeight="600">

    <StackPanel>
        <TextBlock Text="Áttekintés" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="AT Framework — újraépítve, modulonként."
                   Style="{StaticResource SubtleTextStyle}"
                   Margin="0,4,0,24" />

        <UniformGrid Columns="3" Rows="1">

            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Web tesztelés" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Böngésző-automatizálás."
                               Style="{StaticResource SubtleTextStyle}" Margin="0,6,0,16" />
                    <Button Content="Megnyitás"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Command="{Binding GoToWebCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="6,0">
                <StackPanel>
                    <TextBlock Text="Windows desktop" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Desktop-app automatizálás."
                               Style="{StaticResource SubtleTextStyle}" Margin="0,6,0,16" />
                    <Button Content="Megnyitás"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Command="{Binding GoToDesktopCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                <StackPanel>
                    <TextBlock Text="Mobil (Android / iOS)" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Android/IOS emulátoros tesztelés."
                               Style="{StaticResource SubtleTextStyle}" Margin="0,6,0,16" />
                    <Button Content="Megnyitás"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Command="{Binding GoToMobileCommand}" />
                </StackPanel>
            </Border>

        </UniformGrid>

        <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Üzenet típusok a tesztelés során." Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text=""
                           Style="{StaticResource SubtleTextStyle}" Margin="0,6,0,16" MaxWidth="480" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Info"
                            Style="{StaticResource GhostButtonStyle}"
                            Foreground="{StaticResource Brush.TextSecondary}"
                            BorderBrush="{StaticResource Brush.Border}"
                            Margin="0,0,10,0"
                            Command="{Binding ShowInfoToastCommand}" />
                    <Button Content="Siker"
                            Style="{StaticResource GhostButtonStyle}"
                            Foreground="{StaticResource Brush.Success}"
                            BorderBrush="{StaticResource Brush.Success}"
                            Margin="0,0,10,0"
                            Command="{Binding ShowSuccessToastCommand}" />
                    <Button Content="Figyelmeztetés"
                            Style="{StaticResource GhostButtonStyle}"
                            Foreground="{StaticResource Brush.Warning}"
                            BorderBrush="{StaticResource Brush.Warning}"
                            Margin="0,0,10,0"
                            Command="{Binding ShowWarningToastCommand}" />
                    <Button Content="Hiba"
                            Style="{StaticResource GhostButtonStyle}"
                            Foreground="{StaticResource Brush.Danger}"
                            BorderBrush="{StaticResource Brush.Danger}"
                            Command="{Binding ShowErrorToastCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>