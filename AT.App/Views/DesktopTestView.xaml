<UserControl x:Class="AT.App.Views.DesktopTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AT.App.Converters"
             Focusable="True"
             PreviewKeyDown="DesktopTestView_PreviewKeyDown">

    <UserControl.Resources>
        <conv:TestStatusToLabelConverter x:Key="TestStatusToLabelConverter" />

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Passed">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtleTextStyle}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="TagBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TagBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="ColumnHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource SubtleTextStyle}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Új teszt"
                        Style="{StaticResource GhostButtonStyle}"
                        Margin="0,0,10,0"
                        Command="{Binding NewTestCommand}" />
                <Button Content="Ütemezés létrehozása"
                        Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding ScheduleTaskCommand}" />
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Teszt megnevezése" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                        <TextBox Text="{Binding TestName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Kategória" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                        <ComboBox ItemsSource="{Binding AvailableCategories}"
                                  SelectedValue="{Binding SelectedCategoryId, Mode=TwoWay}"
                                  SelectedValuePath="Id">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===================== ÚJ LÉPÉS FORM ===================== -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Új lépés" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Művelet" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="NewActionComboBox" ItemsSource="{Binding AvailableActions}" SelectedItem="{Binding NewAction}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static conv:DesktopStepActionToLabelConverter.Instance}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Timeout (mp)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding NewTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10" IsEnabled="{Binding IsLocatorNeeded}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Lokátor típusa" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding AvailableLocatorTypes}" SelectedItem="{Binding NewLocatorType}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static conv:LocatorTypeToLabelConverter.Instance}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Lokátor (AutomationId / Name / ClassName / XPath)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding NewLocator, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10" IsEnabled="{Binding IsLocatorNeeded}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Elem sorszáma" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding NewElementIndex, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                        <TextBlock Text="Ha több egyforma lokátor is van (pl. lista/rács minden sorában ugyanaz), itt add meg, hányadikkal dolgozzon a lépés — 1-től számolva (1 = első elem). Üresen az első elemmel."
                                   Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Button Content="Elem-kereső megnyitása"
                        Style="{StaticResource GhostButtonStyle}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,10"
                        Command="{Binding OpenElementFinderCommand}" />

                <Grid Margin="0,0,0,10" IsEnabled="{Binding IsLocatorNeeded}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Újrapróbálkozás" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding NewRetryCount, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Tartalék lokátor típusa" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding AvailableLocatorTypes}" SelectedItem="{Binding NewFallbackLocatorType}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static conv:LocatorTypeToLabelConverter.Instance}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tartalék lokátor (self-healing — ha az elsődleges nem található)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding NewFallbackLocator, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10"
                      IsEnabled="{Binding IsTargetNeeded}"
                      Visibility="{Binding IsTargetNeeded, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Cél lokátor típusa" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding AvailableLocatorTypes}" SelectedItem="{Binding NewTargetLocatorType}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static conv:LocatorTypeToLabelConverter.Instance}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Cél lokátor (Drag&amp;Drop célpontja)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding NewTargetLocator, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0" IsEnabled="{Binding IsValueNeeded}">
                        <TextBlock Text="Érték (.exe útvonal / ablakcím / szöveg / attribútumnév / kulcs=érték)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <Button Grid.Column="1" Content="{Binding AddButtonLabel}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            VerticalAlignment="Bottom"
                            Command="{Binding AddStepCommand}" />
                </Grid>

                <!-- ===================== FELTÉTELES VÉGREHAJTÁS (if/else ugrás) ===================== -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Címke" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding NewLabel, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Siker esetén ugrás" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding AvailableGoToLabels}" SelectedItem="{Binding NewOnSuccessGoToLabel}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Hiba esetén ugrás" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding AvailableGoToLabels}" SelectedItem="{Binding NewOnFailureGoToLabel}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="A címke a lépés saját azonosítója (automatikusan generált, felülírható) — más lépések erre hivatkozva ugorhatnak ide. Üresen hagyott ugrás-mező esetén a következő lépés jön (hiba esetén a lenti beállítás szerint)."
                           Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />

                <!-- ===================== HIBAKEZELÉSI BEÁLLÍTÁSOK ===================== -->
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <CheckBox Content="Hiba esetén is folytatódjon a futtatás"
                              IsChecked="{Binding NewContinueOnError}"
                              VerticalAlignment="Center" Margin="0,0,24,0" />
                    <CheckBox Content="Kihagyás (ne hajtsa végre)"
                              IsChecked="{Binding NewSkip}"
                              VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"
                            Visibility="{Binding IsEditing, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="Lépés szerkesztése — a Mentés felülírja az eredetit."
                               Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="Mégse" Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding CancelEditCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===================== LÉPÉSLISTA ===================== -->
        <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,20" Grid.IsSharedSizeScope="True">
            <StackPanel>
                <Grid Margin="20,20,20,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Lépések" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Betöltés fájlból" Style="{StaticResource GhostButtonStyle}"
                                Margin="0,0,10,0" Command="{Binding LoadStepsCommand}" />
                        <Button Content="Mentés fájlba" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding SaveStepsCommand}" />
                    </StackPanel>
                </Grid>


                <Grid Margin="20,0,20,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="StepDragHandle" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" SharedSizeGroup="StepDuration" />
                        <ColumnDefinition Width="110" SharedSizeGroup="StepStatus" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="StepActions" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0" Padding="0,0,8,0">
                        <TextBlock Text="" Width="20" />
                    </Border>
                    <Border Grid.Column="1" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0" Margin="12,0,0,0" Padding="0,0,12,0">
                        <TextBlock Text="Művelet / Lokátor / Érték" Style="{StaticResource ColumnHeaderStyle}" />
                    </Border>
                    <Border Grid.Column="2" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
                        <TextBlock Text="Idő" Style="{StaticResource ColumnHeaderStyle}" HorizontalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="3" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0" Padding="0,0,12,0">
                        <TextBlock Text="Státusz" Style="{StaticResource ColumnHeaderStyle}" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="4" Text="Műveletek" Style="{StaticResource ColumnHeaderStyle}" HorizontalAlignment="Center" Margin="12,0,0,0" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="20,12"
                                    Cursor="Hand"
                                    AllowDrop="True"
                                    MouseLeftButtonDown="StepRow_MouseLeftButtonDown"
                                    DragOver="StepRow_DragOver"
                                    Drop="StepRow_Drop">
                                <Border.Background>
                                    <MultiBinding Converter="{x:Static conv:SameReferenceToBrushConverter.Instance}">
                                        <Binding Path="." />
                                        <Binding Path="DataContext.SelectedStep" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                    </MultiBinding>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="StepDragHandle" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" SharedSizeGroup="StepDuration" />
                                        <ColumnDefinition Width="110" SharedSizeGroup="StepStatus" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="StepActions" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0" Padding="0,0,8,0">
                                        <TextBlock Text="⋮⋮" FontSize="16"
                                                   Foreground="{StaticResource Brush.TextMuted}"
                                                   VerticalAlignment="Center"
                                                   Cursor="SizeAll"
                                                   MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                                                   ToolTip="Húzd az átrendezéshez" />
                                    </Border>

                                    <Border Grid.Column="1" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0" Padding="12,0,12,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Step.Name}" FontSize="14"
                                                       Foreground="{StaticResource Brush.TextPrimary}" />
                                            <Border Style="{StaticResource TagBadgeStyle}" Background="{StaticResource Brush.Warning}"
                                                    Visibility="{Binding Step.Skip, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                                <TextBlock Text="Kihagyva" Style="{StaticResource TagBadgeTextStyle}" />
                                            </Border>
                                            <Border Style="{StaticResource TagBadgeStyle}" Background="{StaticResource Brush.Accent}"
                                                    Visibility="{Binding Step.ContinueOnError, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                                <TextBlock Text="Folytatás hiba esetén" Style="{StaticResource TagBadgeTextStyle}" />
                                            </Border>
                                            <Border Style="{StaticResource TagBadgeStyle}" Background="{StaticResource Brush.Accent}"
                                                    Visibility="{Binding Step.ElementIndex, Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                                                <TextBlock Style="{StaticResource TagBadgeTextStyle}">
                                                    <Run Text="Elem #" />
                                                    <Run Text="{Binding Step.ElementIndex, Mode=OneWay}" />
                                                </TextBlock>
                                            </Border>
                                            <Border Style="{StaticResource TagBadgeStyle}" Background="{StaticResource Brush.Accent}"
                                                    Visibility="{Binding Step.RetryCount, Converter={x:Static conv:IntGreaterThanZeroToVisibilityConverter.Instance}}">
                                                <TextBlock Style="{StaticResource TagBadgeTextStyle}">
                                                    <Run Text="Retry ×" />
                                                    <Run Text="{Binding Step.RetryCount, Mode=OneWay}" />
                                                </TextBlock>
                                            </Border>
                                            <Border Style="{StaticResource TagBadgeStyle}" Background="{StaticResource Brush.Accent}"
                                                    Visibility="{Binding Step.FallbackLocator, Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                                                <TextBlock Text="Self-healing" Style="{StaticResource TagBadgeTextStyle}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource SubtleTextStyle}" Margin="0,2,0,0">
                                            <Run Text="Címke:" />
                                            <Run Text="{Binding Step.Label, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SubtleTextStyle}"
                                                   Visibility="{Binding Step.OnSuccessGoToLabel, Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                                            <Run Text="Siker → ugrás:" />
                                            <Run Text="{Binding Step.OnSuccessGoToLabel, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Success}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SubtleTextStyle}"
                                                   Visibility="{Binding Step.OnFailureGoToLabel, Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                                            <Run Text="Hiba → ugrás:" />
                                            <Run Text="{Binding Step.OnFailureGoToLabel, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Danger}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Message}" Style="{StaticResource SubtleTextStyle}"
                                                   Foreground="{StaticResource Brush.Danger}"
                                                   Visibility="{Binding Message, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                                    </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
                                        <TextBlock Text="{Binding DurationText}"
                                                   Style="{StaticResource SubtleTextStyle}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <Border Grid.Column="3" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0" Padding="0,0,12,0">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource TestStatusToLabelConverter}}"
                                                   Style="{StaticResource StatusTextStyle}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <WrapPanel Grid.Column="4" Orientation="Horizontal" Margin="12,0,0,0">
                                        <Button Content="Innentől" ToolTip="Futtatás ettől a lépéstől kezdve"
                                                Style="{StaticResource LinkButtonStyle}"
                                                Foreground="{StaticResource Brush.Accent}"
                                                Command="{Binding DataContext.RunFromStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="↑" ToolTip="Feljebb"
                                                Style="{StaticResource LinkButtonStyle}"
                                                Foreground="{StaticResource Brush.TextSecondary}"
                                                Command="{Binding DataContext.MoveStepUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="↓" ToolTip="Lejjebb"
                                                Style="{StaticResource LinkButtonStyle}"
                                                Foreground="{StaticResource Brush.TextSecondary}"
                                                Command="{Binding DataContext.MoveStepDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Duplikálás"
                                                Style="{StaticResource LinkButtonStyle}"
                                                Foreground="{StaticResource Brush.Accent}"
                                                Command="{Binding DataContext.DuplicateStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Szerkesztés"
                                                Style="{StaticResource LinkButtonStyle}"
                                                Foreground="{StaticResource Brush.Accent}"
                                                Command="{Binding DataContext.EditStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Törlés"
                                                Style="{StaticResource LinkButtonStyle}"
                                                Foreground="{StaticResource Brush.Danger}"
                                                Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Még nincs lépés — vedd fel az elsőt a fenti formmal (indítsd 'LaunchApp'-pal)."
                           Style="{StaticResource SubtleTextStyle}"
                           Margin="20,8,20,20"
                           Visibility="{Binding Steps.Count, Converter={x:Static conv:ZeroToVisibilityConverter.Instance}}" />
            </StackPanel>
        </Border>

        <!-- ===================== VEZÉRLŐK ===================== -->
        <StackPanel Orientation="Horizontal">
            <Button Content="Futtatás" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding RunStepsCommand}" Margin="0,0,10,0" />
            <Button Style="{StaticResource GhostButtonStyle}"
                    Command="{Binding ToggleRecordingCommand}" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#FF4D4D" Margin="0,0,6,0" VerticalAlignment="Center"
                             Visibility="{Binding IsRecording, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                    <TextBlock Text="{Binding IsRecording, Converter={x:Static conv:RecordingButtonLabelConverter.Instance}}" />
                </StackPanel>
            </Button>
            <Button Content="Alkalmazás bezárása" Style="{StaticResource GhostButtonStyle}"
                    Command="{Binding CloseAppCommand}" Margin="0,0,10,0" />
            <Button Content="Riport exportálása" Style="{StaticResource GhostButtonStyle}"
                    Command="{Binding ExportReportCommand}"
                    Visibility="{Binding HasLastRun, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
            <TextBlock Text="Fut…" Style="{StaticResource SubtleTextStyle}"
                       VerticalAlignment="Center" Margin="14,0,0,0"
                       Visibility="{Binding IsRunning, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
            <TextBlock Text="● Felvétel folyamatban — használd normálisan a tesztelt alkalmazást"
                       Foreground="#FF4D4D"
                       VerticalAlignment="Center" Margin="14,0,0,0"
                       Visibility="{Binding IsRecording, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
        </StackPanel>

    </StackPanel>
</UserControl>
