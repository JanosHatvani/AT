<UserControl x:Class="AT.App.Views.ScheduledTasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AT.App.Converters">

    <UserControl.Resources>
        <Style x:Key="TagBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TagBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="ScheduleActionButtonStyle" TargetType="Button" BasedOn="{StaticResource LinkButtonStyle}">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>

        <!-- A Szerkesztés/Be-kikapcsolás/Törlés gombsor saját, elkülönült "mini kártyája"
             a fő-kártyán belül
         -->
        <Style x:Key="ScheduleActionsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Background}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="16,0,0,0" />
        </Style>

        <!-- Kártyafejléc-elrendezés: név, alatta a badge-ek (WrapPanel, saját sorban),
             alatta az időzítés-infó — mind balra. Jobbra a Szerkesztés/Be-kikapcsolás/
             Törlés gombsor, egy elkülönült, saját hátterű "mini kártyában"
        -->
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource SubtleTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <Button Grid.Column="1" Content="Frissítés"
                    Style="{StaticResource GhostButtonStyle}"
                    VerticalAlignment="Top"
                    ToolTip="Újratölti a listát — hasznos, ha egy másik nézeten most hoztál létre egy ütemezést, ami még nem látszik itt"
                    Command="{Binding LoadRowsCommand}" />
        </Grid>

        <!-- ===================== PLATFORM + KATEGÓRIA SZŰRŐ ===================== -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Platform" Style="{StaticResource SubtleTextStyle}" Margin="0,0,0,4" />
                <ComboBox Width="160" ItemsSource="{Binding PlatformFilterOptions}"
                          SelectedItem="{Binding SelectedPlatformFilter}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={x:Static conv:PlatformFilterToLabelConverter.Instance}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Kategória" Style="{StaticResource SubtleTextStyle}" Margin="0,0,0,4" />
                <ComboBox Width="200" ItemsSource="{Binding AvailableCategoryFilters}"
                          SelectedItem="{Binding SelectedCategoryFilter}"
                          DisplayMemberPath="Name" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Még nincs ütemezett feladat — a Web / Desktop / Mobil oldalakon az &quot;Ütemezés létrehozása&quot; gombbal hozhatsz létre egyet a jelenlegi lépéssorodból."
                           Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap"
                           Visibility="{Binding HasRows, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}" />

                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                <Expander>
                                    <Expander.Header>

                                        <Grid Margin="0,0,16,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="200" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Brush.TextPrimary}"
                                                           TextWrapping="Wrap" />

                                                <WrapPanel Margin="0,6,0,0">
                                                    <Border Style="{StaticResource TagBadgeStyle}" Background="{StaticResource Brush.Accent}" Margin="0,0,8,4">
                                                        <TextBlock Text="{Binding TargetLabel}" Style="{StaticResource TagBadgeTextStyle}" />
                                                    </Border>
                                                    <Border Style="{StaticResource TagBadgeStyle}" Background="{StaticResource Brush.Success}" Margin="0,0,8,4">
                                                        <TextBlock Text="{Binding CategoryLabel}" Style="{StaticResource TagBadgeTextStyle}" />
                                                    </Border>
                                                    <Border Style="{StaticResource TagBadgeStyle}" Background="{StaticResource Brush.TextMuted}" Margin="0,0,8,4">
                                                        <TextBlock Text="{Binding CadenceLabel}" Style="{StaticResource TagBadgeTextStyle}" />
                                                    </Border>
                                                    <Border Style="{StaticResource TagBadgeStyle}" Background="{StaticResource Brush.TextMuted}" Margin="0,0,8,4"
                                                            Visibility="{Binding IsEnabled, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}">
                                                        <TextBlock Text="Kikapcsolva" Style="{StaticResource TagBadgeTextStyle}" />
                                                    </Border>
                                                </WrapPanel>

                                                <TextBlock Style="{StaticResource SubtleTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap">
                                                    <Run Text="{Binding ScheduleDetailText, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding StepCount, Mode=OneWay}" />
                                                    <Run Text=" lépés · Következő futás: " />
                                                    <Run Text="{Binding NextRunText, Mode=OneWay}" FontWeight="SemiBold" />
                                                </TextBlock>
                                            </StackPanel>


                                            <Border Grid.Column="1" Style="{StaticResource ScheduleActionsCardStyle}">
                                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button Content="Szerkesztés"
                                                            Style="{StaticResource ScheduleActionButtonStyle}"
                                                            Foreground="{StaticResource Brush.Accent}"
                                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="{Binding IsEnabled, Converter={x:Static conv:EnabledToToggleLabelConverter.Instance}}"
                                                            Style="{StaticResource ScheduleActionButtonStyle}"
                                                            Foreground="{StaticResource Brush.Accent}"
                                                            Margin="6,0,0,0"
                                                            Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Törlés"
                                                            Style="{StaticResource ScheduleActionButtonStyle}"
                                                            Foreground="{StaticResource Brush.Danger}"
                                                            Margin="6,0,0,0"
                                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </WrapPanel>
                                            </Border>
                                        </Grid>
                                    </Expander.Header>

                                    <!-- ===================== LENYITOTT RÉSZLETEK: BEÁGYAZOTT LÉPÉSSOR (csak megtekintésre) ===================== -->
                                    <StackPanel Margin="0,12,0,4">
                                        <TextBlock Text="Utolsó futás:" Style="{StaticResource SubtleTextStyle}" Margin="0,0,0,8">
                                            <Run Text="{Binding LastRunText, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>

                                        <ItemsControl ItemsSource="{Binding Steps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,8">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                                       Foreground="{StaticResource Brush.TextPrimary}" TextWrapping="Wrap" />
                                                            <TextBlock Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0">
                                                                <Run Text="Címke:" />
                                                                <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Expander>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
