<UserControl x:Class="AT.App.Views.MobileTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AT.App.Converters">

    <UserControl.Resources>
        <conv:TestStatusToLabelConverter x:Key="TestStatusToLabelConverter" />

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Passed">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtleTextStyle}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- ===================== BAL OLDAL: LÉPÉSLISTA ===================== -->
        <StackPanel Grid.Column="0" Margin="0,0,24,0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource SubtleTextStyle}" Margin="0,4,0,24" />

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Teszt megnevezése" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                    <TextBox Text="{Binding TestName, UpdateSourceTrigger=PropertyChanged}" Width="200" MaxWidth="400" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- ===================== ÚJ LÉPÉS FORM ===================== -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Új lépés" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Művelet" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding AvailableActions}" SelectedItem="{Binding NewAction}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static conv:MobileStepActionToLabelConverter.Instance}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Timeout (mp)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding NewTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"  />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10" IsEnabled="{Binding IsLocatorNeeded}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Lokátor típusa" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding AvailableLocatorTypes}" SelectedItem="{Binding NewLocatorType}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static conv:LocatorTypeToLabelConverter.Instance}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Lokátor (resource-id / XPath / content-desc)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding NewLocator, UpdateSourceTrigger=PropertyChanged}"  />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Érték (AVD név / .apk útvonal / szöveg / attribútum)" Style="{StaticResource FieldLabelStyle}"
                                       Visibility="{Binding IsSwipeDirection, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}" />
                            <TextBox Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" Padding="6"
                                     IsEnabled="{Binding IsValueNeeded}"
                                     Visibility="{Binding IsSwipeDirection, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}" />

                            <TextBlock Text="Irány" Style="{StaticResource FieldLabelStyle}"
                                       Visibility="{Binding IsSwipeDirection, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                            <ComboBox ItemsSource="{Binding SwipeDirections}" SelectedItem="{Binding NewValue}"
                                      Visibility="{Binding IsSwipeDirection, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                        </StackPanel>

                        <Button Grid.Column="1" Content="{Binding AddButtonLabel}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                VerticalAlignment="Bottom"
                                Command="{Binding AddStepCommand}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"
                                Visibility="{Binding IsEditing, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <TextBlock Text="Lépés szerkesztése — a Mentés felülírja az eredetit."
                                   Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Content="Mégse" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding CancelEditCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===================== LÉPÉSLISTA ===================== -->
            <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,20">
                <StackPanel>
                    
                    <Grid Margin="20,20,20,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Lépések" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Betöltés fájlból" Style="{StaticResource GhostButtonStyle}"
                                Margin="0,0,10,0" Command="{Binding LoadStepsCommand}" />
                            <Button Content="Mentés fájlba" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding SaveStepsCommand}" />
                        </StackPanel>
                    </Grid>
                    
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="20,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Step.Name}" FontSize="14"
                                                       Foreground="{StaticResource Brush.TextPrimary}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource SubtleTextStyle}"
                                                       Foreground="{StaticResource Brush.Danger}"
                                                       Visibility="{Binding Message, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Status, Converter={StaticResource TestStatusToLabelConverter}}"
                                                   Style="{StaticResource StatusTextStyle}"
                                                   VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Content="Szerkesztés"
                                                    Style="{StaticResource LinkButtonStyle}"
                                                    Foreground="{StaticResource Brush.Accent}"
                                                    Command="{Binding DataContext.EditStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Törlés"
                                                    Style="{StaticResource LinkButtonStyle}"
                                                    Foreground="{StaticResource Brush.Danger}"
                                                    Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Még nincs lépés — indíts emulátort 'StartEmulator'-ral, majd 'LaunchApp'-pal telepítsd az apk-t."
                               Style="{StaticResource SubtleTextStyle}"
                               Margin="20,8,20,20" TextWrapping="Wrap"
                               Visibility="{Binding Steps.Count, Converter={x:Static conv:ZeroToVisibilityConverter.Instance}}" />
                </StackPanel>
            </Border>

            <!-- ===================== VEZÉRLŐK ===================== -->
            <StackPanel Orientation="Horizontal">
                <Button Content="Futtatás" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding RunStepsCommand}" Margin="0,0,10,0" />
                <Button Content="Leállítás" Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding StopAllCommand}" />
                <TextBlock Text="Fut…" Style="{StaticResource SubtleTextStyle}"
                           VerticalAlignment="Center" Margin="14,0,0,0"
                           Visibility="{Binding IsRunning, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
            </StackPanel>
        </StackPanel>

        <!-- ===================== JOBB OLDAL: ÉLŐ KIJELZŐ ===================== -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Élő kijelző" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4" />
                <TextBlock Text="A régi verzió egy sosem írt fájlt figyelt — ez most tényleg a driver-től kér képet."
                           Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12" />

                <Border Background="{StaticResource Brush.Background}" CornerRadius="8" Height="360" ClipToBounds="True">
                    <Grid>
                        <Image Source="{Binding ScreenImage}" Stretch="Uniform"
                               MouseLeftButtonDown="ScreenImage_MouseLeftButtonDown"
                               Cursor="{Binding IsPicking, Converter={x:Static conv:PickingCursorConverter.Instance}}" />
                        <TextBlock Text="Nincs kép — indítsd el a tükrözést"
                                   Style="{StaticResource SubtleTextStyle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsMirroring, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}" />
                        <Border BorderBrush="{StaticResource Brush.Accent}" BorderThickness="3" IsHitTestVisible="False"
                                Visibility="{Binding IsPicking, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                    </Grid>
                </Border>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />   
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,12,0,0">
                        <Button Content="{Binding IsMirroring, Converter={x:Static conv:MirrorButtonLabelConverter.Instance}}"
                            Style="{StaticResource GhostButtonStyle}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,8"
                            Command="{Binding ToggleMirroringCommand}" />
                        <Button Content="{Binding IsPicking, Converter={x:Static conv:PickingButtonLabelConverter.Instance}}"
                            Style="{StaticResource GhostButtonStyle}"
                            HorizontalAlignment="Center"
                            Command="{Binding TogglePickingCommand}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Kattints a képen a kívánt elemre — nem küldi tovább a kattintást az eszköznek, csak leolvassa, mi van ott."
                           Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Visibility="{Binding IsPicking, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />

                <ItemsControl ItemsSource="{Binding InspectorCandidates}" Margin="0,10,0,0"
                              Visibility="{Binding HasInspectorResult, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource SubtleTextStyle}"
                                               TextWrapping="Wrap" Margin="0,2,0,6" />
                                    <Button Content="Használat" Style="{StaticResource GhostButtonStyle}"
                                            HorizontalAlignment="Left" Padding="12,4"
                                            Command="{Binding DataContext.UseInspectorCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>