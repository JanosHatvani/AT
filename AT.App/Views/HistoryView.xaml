<UserControl x:Class="AT.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AT.App.Converters">

    <UserControl.Resources>
        <Style x:Key="ColumnHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtleTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="TargetBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
        </Style>

        <Style x:Key="TargetBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="ResultBadgeStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasFailures}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasFailures}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="{Binding Description}" Style="{StaticResource SubtleTextStyle}" Margin="0,4,0,24" TextWrapping="Wrap" />

        <Border Style="{StaticResource CardStyle}" Padding="0">
            <StackPanel>
                <Grid Margin="20,20,20,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Futtatások" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Frissítés" Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding LoadCommand}" />
                </Grid>

                <!-- Oszlop-fejléc -->
                <Grid Margin="20,0,20,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Teszt neve" Style="{StaticResource ColumnHeaderStyle}" />
                    <TextBlock Grid.Column="1" Text="Modul" Style="{StaticResource ColumnHeaderStyle}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="Időpont" Style="{StaticResource ColumnHeaderStyle}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="Eredmény" Style="{StaticResource ColumnHeaderStyle}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="Időtartam" Style="{StaticResource ColumnHeaderStyle}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="Műveletek" Style="{StaticResource ColumnHeaderStyle}" HorizontalAlignment="Center" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Runs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="20,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="160" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding TestName}" FontSize="14"
                                               Foreground="{StaticResource Brush.TextPrimary}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />

                                    <Border Grid.Column="1" Style="{StaticResource TargetBadgeStyle}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TargetLabel}" Style="{StaticResource TargetBadgeTextStyle}" />
                                    </Border>

                                    <TextBlock Grid.Column="2" Text="{Binding StartedAtText}"
                                               Style="{StaticResource SubtleTextStyle}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="3" Text="{Binding SummaryText}"
                                               Style="{StaticResource ResultBadgeStyle}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="4" Text="{Binding DurationText}"
                                               Style="{StaticResource SubtleTextStyle}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <WrapPanel Grid.Column="5" Orientation="Horizontal"
                                               HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="Riport exportálása"
                                                Style="{StaticResource LinkButtonStyle}"
                                                Foreground="{StaticResource Brush.Accent}"
                                                Command="{Binding DataContext.ExportReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Törlés"
                                                Style="{StaticResource LinkButtonStyle}"
                                                Foreground="{StaticResource Brush.Danger}"
                                                Command="{Binding DataContext.DeleteRunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Még nincs egyetlen futtatás sem — a Web / Desktop / Mobil modulokban végzett futtatások itt jelennek meg."
                           Style="{StaticResource SubtleTextStyle}"
                           Margin="20,8,20,20" TextWrapping="Wrap"
                           Visibility="{Binding HasRuns, Converter={x:Static conv:InverseBoolToVisibilityConverter.Instance}}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
