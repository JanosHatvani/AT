<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Semleges felületek -->
    <Color x:Key="Color.Background">#FFF7F8FA</Color>
    <Color x:Key="Color.Surface">#FFFFFFFF</Color>
    <Color x:Key="Color.ContentBackground">#FFEFF5F4</Color>
    <Color x:Key="Color.Border">#FFE3E5EA</Color>

    <!-- Sidebar (sötét oldalsáv) -->
    <Color x:Key="Color.SidebarBg">#FF1B2130</Color>
    <Color x:Key="Color.SidebarHover">#FF272E40</Color>
    <Color x:Key="Color.SidebarTextPrimary">#FFEDEEF2</Color>
    <Color x:Key="Color.SidebarTextSecondary">#FF8B90A0</Color>

    <!-- Szöveg (világos felületen) -->
    <Color x:Key="Color.TextPrimary">#FF1B2130</Color>
    <Color x:Key="Color.TextSecondary">#FF64687A</Color>
    <Color x:Key="Color.TextMuted">#FF9A9EAD</Color>

    <!-- Márka / accent -->
    <Color x:Key="Color.Accent">#FF0D9488</Color>
    <Color x:Key="Color.AccentMuted">#FFE6F5F3</Color>

    <!-- Státusz színek -->
    <Color x:Key="Color.Success">#FF1E9E6B</Color>
    <Color x:Key="Color.SuccessMuted">#FFE6F6EF</Color>
    <Color x:Key="Color.Warning">#FFD97706</Color>
    <Color x:Key="Color.WarningMuted">#FFFDF1E0</Color>
    <Color x:Key="Color.Danger">#FFDC3545</Color>
    <Color x:Key="Color.DangerMuted">#FFFCEAEC</Color>

    <!-- Brush wrapperek -->
    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.ContentBackground" Color="{StaticResource Color.ContentBackground}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />

    <SolidColorBrush x:Key="Brush.SidebarBg" Color="{StaticResource Color.SidebarBg}" />
    <SolidColorBrush x:Key="Brush.SidebarHover" Color="{StaticResource Color.SidebarHover}" />
    <SolidColorBrush x:Key="Brush.SidebarTextPrimary" Color="{StaticResource Color.SidebarTextPrimary}" />
    <SolidColorBrush x:Key="Brush.SidebarTextSecondary" Color="{StaticResource Color.SidebarTextSecondary}" />

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentMuted" Color="{StaticResource Color.AccentMuted}" />

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessMuted" Color="{StaticResource Color.SuccessMuted}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningMuted" Color="{StaticResource Color.WarningMuted}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerMuted" Color="{StaticResource Color.DangerMuted}" />

</ResourceDictionary>
