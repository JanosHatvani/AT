<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Sötét téma — ugyanazok a kulcsok, mint a Colors.xaml-ban, hogy a Controls.xaml
        és minden View változtatás nélkül működjön mindkét témával. A ThemeService ezt
        a dictionary-t cseréli be a Colors.xaml helyére az Application.Resources
        MergedDictionaries-ben.

        Alap paletta:
          #232931 - legsötétebb (fő háttér)
          #393E46 - sötét, de a háttérnél világosabb (felületek / sidebar)
          #4ECCA3 - menta/türkiz accent
          #EEEEEE - halvány szürkésfehér (elsődleges szöveg)
    -->

    <!-- Semleges felületek -->
    <Color x:Key="Color.Background">#FF232931</Color>
    <Color x:Key="Color.Surface">#FF393E46</Color>
    <Color x:Key="Color.ContentBackground">#FF232931</Color>
    <Color x:Key="Color.Border">#FF5B6270</Color>

    <!-- Sidebar -->
    <Color x:Key="Color.SidebarBg">#FF1B2027</Color>
    <Color x:Key="Color.SidebarHover">#FF393E46</Color>
    <Color x:Key="Color.SidebarTextPrimary">#FFEEEEEE</Color>
    <Color x:Key="Color.SidebarTextSecondary">#FF9CA3AF</Color>

    <!-- Szöveg (sötét felületen) — szándékosan magas kontraszttal, hogy a cím/leírás
         és minden más szöveg egyértelműen olvasható legyen a sötét hátterek felett. -->
    <Color x:Key="Color.TextPrimary">#FFFFFFFF</Color>
    <Color x:Key="Color.TextSecondary">#FFC7CCD4</Color>
    <Color x:Key="Color.TextMuted">#FF8891A0</Color>

    <!-- Márka / accent -->
    <Color x:Key="Color.Accent">#FF4ECCA3</Color>
    <Color x:Key="Color.AccentMuted">#FF2A3D38</Color>

    <!-- Státusz színek — az accent zöld-türkizével összhangban, de eltérő jelentéssel -->
    <Color x:Key="Color.Success">#FF4ECCA3</Color>
    <Color x:Key="Color.SuccessMuted">#FF223730</Color>
    <Color x:Key="Color.Warning">#FFF5A623</Color>
    <Color x:Key="Color.WarningMuted">#FF3A2E17</Color>
    <Color x:Key="Color.Danger">#FFEF5350</Color>
    <Color x:Key="Color.DangerMuted">#FF3A2426</Color>

    <!-- Brush wrapperek -->
    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.ContentBackground" Color="{StaticResource Color.ContentBackground}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />

    <SolidColorBrush x:Key="Brush.SidebarBg" Color="{StaticResource Color.SidebarBg}" />
    <SolidColorBrush x:Key="Brush.SidebarHover" Color="{StaticResource Color.SidebarHover}" />
    <SolidColorBrush x:Key="Brush.SidebarTextPrimary" Color="{StaticResource Color.SidebarTextPrimary}" />
    <SolidColorBrush x:Key="Brush.SidebarTextSecondary" Color="{StaticResource Color.SidebarTextSecondary}" />

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentMuted" Color="{StaticResource Color.AccentMuted}" />

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessMuted" Color="{StaticResource Color.SuccessMuted}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningMuted" Color="{StaticResource Color.WarningMuted}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerMuted" Color="{StaticResource Color.DangerMuted}" />

</ResourceDictionary>
